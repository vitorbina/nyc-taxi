#Minio configuration
export MINIO_ROOT_USER=user
export MINIO_ROOT_PASSWORD=password
export MINIO_ENDPOINT=http://localhost:9000
export MINIO_CONSOLE=http://localhost:9001
export MINIO_BUCKET=data-lake-nyc

# Spark — para usar o cluster Docker: SPARK_MASTER_URL=spark://spark-master:7077
#          e SPARK_S3A_ENDPOINT=http://minio:9000
export SPARK_MASTER_URL=local[*]
export SPARK_S3A_ENDPOINT=http://localhost:9000

export PYTHONPATH="${PYTHONPATH}:$(pwd)"
export AIRFLOW_HOME=$(pwd)
export AIRFLOW__CORE__LOAD_EXAMPLES=False
