#Minio configuration
export MINIO_ROOT_USER=user
export MINIO_ROOT_PASSWORD=password
export MINIO_ENDPOINT=http://<LOCAL_IP>:9000
export MINIO_CONSOLE=http://<LOCAL_IP>:9001
export MINIO_BUCKET=nyc-taxi-lake

#Airflow configuration for minio connection.
#Substitute <LOCAL_IP> with the actual local IP address of your machine, username and password with the ones you set for Minio.
export AIRFLOW_CONN_MINIO_CONN='aws://user:password@?endpoint_url=http%3A%2F%2F<LOCAL_IP>%3A9000'

export AIRFLOW_HOME=$(pwd)